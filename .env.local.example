# ============================================================
# BAW Group — Absensi + E-Member/Webstore (env gabungan)
# Copy ke .env.local lalu isi nilai asli
# ============================================================

# === JSONBin.io (SEMUA data teks/master data) ===
# Daftar gratis di https://jsonbin.io -> ambil "Master Key" di menu API Keys
JSONBIN_API_KEY=

# Buat bin baru untuk masing-masing (isi awal sesuai keterangan), lalu isi Bin ID:
JSONBIN_BIN_ID_ATTENDANCE=        # isi awal: []
JSONBIN_BIN_ID_BRANCHES=          # isi awal: []
JSONBIN_BIN_ID_EMPLOYEES=         # isi awal: []
JSONBIN_BIN_ID_ANNOUNCEMENT=      # isi awal: {"text": "", "updatedAt": null}
JSONBIN_BIN_ID_STORE_PROFILE=     # isi awal: {}
JSONBIN_BIN_ID_PRICING=           # isi awal: {}
JSONBIN_BIN_ID_MEMBERS=           # isi awal: []
JSONBIN_BIN_ID_VOUCHERS=          # isi awal: []

# === Google Drive (foto) — pakai OAuth akun Gmail sendiri, BUKAN Service Account ===
# Ikuti README bagian Google Drive untuk cara ambil 3 nilai di bawah ini.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=            # folder utk foto swafoto absensi (sudah ada)
GOOGLE_DRIVE_FOLDER_ID_PRODUCTS=   # folder baru khusus foto produk
GOOGLE_DRIVE_FOLDER_ID_FEEDS=      # folder baru khusus foto feeds Bawracik

# === Supabase (HANYA rekap/transaksi — database, bukan storage) ===
# Jalankan supabase-schema.sql di SQL Editor Supabase dulu.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === Auth ===
# String acak panjang untuk menandatangani session (semua role).
# Generate: openssl rand -hex 32
SESSION_SECRET=ganti_dengan_string_acak_panjang

# Akun superadmin awal (bootstrap, sebelum ada data di bin employees).
# Setelah punya akun admin/superadmin lewat panel, ini bisa dikosongkan/diganti.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# === WhatsApp ===
# Nomor WA default toko (dipakai template checkout kalau cabang tidak set nomor sendiri)
WA_DEFAULT_NUMBER=
